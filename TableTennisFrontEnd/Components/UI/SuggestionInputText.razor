@using System.Diagnostics.CodeAnalysis
@typeparam TItem
@inject ApiClient ApiClient
@inherits InputBase<int?>

<div class="position-relative">
    <input type="text" class="form-control @CssClass" @bind=CurrentValueAsString
           @oninput="HandleInput" @onblur="HandleBlur" />

    @if (IsLoading)
    {
        <div class="position-absolute top-50 end-0 translate-middle-y me-2">
            <div class="spinner-border spinner-border-sm text-primary"></div>
        </div>
    }

    @if (Suggestions.Any())
    {
        <ul class="list-group position-absolute w-100 shadow z-3">
            @foreach (var item in Suggestions)
            {
                <li class="list-group-item list-group-item-action" role="button" @onclick="() => SelectItem(item)">
                    @DisplayTextSelector(item)
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public Func<TItem, string> DisplayTextSelector { get; set; } = default!;

    [Parameter]
    public Func<string, Task<List<TItem>>> SearchMethod { get; set; } = default!;

    private CancellationTokenSource _cts = new();

    public string SearchText { get; set; } = string.Empty;
    public bool IsLoading { get; set; }
    public List<TItem> Suggestions { get; set; } = [];

    protected override string FormatValueAsString(int? value)
    {
        return base.FormatValueAsString(value);
    }

    protected override bool TryParseValueFromString(string value, [MaybeNullWhen(false)] out int? result, [NotNullWhen(false)] out string validationErrorMessage)
    {
        // var user = await ApiClient.GetFromJsonAsyncAuthorized<TItem>($"/user/firstname/{value}");
        result = null;
        validationErrorMessage = string.Empty;
        return true;
    }

    public async Task SelectItem(TItem item)
    {
        await Task.CompletedTask;
    }

    public async Task HandleInput()
    {
        var theText = CurrentValueAsString;
        Suggestions.Clear();

        _cts.Cancel();

        await Task.CompletedTask;
    }

    public async Task HandleBlur()
    {
        await Task.CompletedTask;
    }
}
