@using System.Diagnostics.CodeAnalysis
@typeparam TItem
@inject ApiClient ApiClient
@inherits InputBase<int?>

<div class="position-relative">
    <input type="text" class="form-control @CssClass" @bind=SearchText @onkeypress="SelectTyped" @onkeydown="SelectThroughKeyboard"
           @oninput="HandleInput" @onblur="HandleBlur" />

    @if (IsLoading)
    {
        <div class="position-absolute top-50 end-0 translate-middle-y me-2">
            <div class="spinner-border spinner-border-sm text-primary"></div>
        </div>
    }

    @if (Suggestions.Any())
    {
        <ul class="list-group position-absolute w-100 shadow z-3">
            @foreach (var item in Suggestions)
            {
                <li class="list-group-item list-group-item-action @(Equals(item, _selectedItem) ? "bg-white text-black" : "")" role="button" @onclick="() => SelectItem(item)">
                    @DisplayTextSelector(item)
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public Func<TItem, string> DisplayTextSelector { get; set; } = default!;

    [Parameter]
    public Func<TItem, int?> ValueSelector { get; set; } = default!;

    [Parameter]
    public Func<string, Task<List<TItem>>> SearchMethod { get; set; } = default!;

    public string SearchText { get; set; } = string.Empty;
    public bool IsLoading { get; set; }
    public List<TItem> Suggestions { get; set; } = [];

    private int _keyboardIndex = -1;
    private TItem? _selectedItem;

    private CancellationTokenSource _cts = new();

    protected override string FormatValueAsString(int? value)
    {
        return base.FormatValueAsString(value);
    }

    protected override bool TryParseValueFromString(string value, [MaybeNullWhen(false)] out int? result, [NotNullWhen(false)] out string validationErrorMessage)
    {
        // var user = await ApiClient.GetFromJsonAsyncAuthorized<TItem>($"/user/firstname/{value}");
        result = null;
        validationErrorMessage = string.Empty;
        return true;
    }

    public async Task SelectItem(TItem item)
    {
        SearchText = DisplayTextSelector(item);
        CurrentValue = ValueSelector(item);
        Suggestions.Clear();
        await ValueChanged.InvokeAsync(CurrentValue);
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    public async Task HandleInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString() ?? "";
        Suggestions.Clear();

        _cts.Cancel();
        _cts = new();

        try
        {
            IsLoading = true;
            await Task.Delay(1000, _cts.Token);
            var items = await ApiClient.GetFromJsonAsyncAuthorized<List<TItem>>($"/user/firstname/{SearchText}", _cts).ConfigureAwait(false);

            if (items == null)
            {
                return;
            }

            foreach (var item in items)
            {
                Suggestions.Add(item);
            }
        }
        catch (OperationCanceledException operationCancelled)
        {
            IsLoading = false;
        }

        IsLoading = false;
    }

    private async Task SelectTyped(KeyboardEventArgs args)
    {
        if (args.Code != "Enter" && args.Code != "NumpadEnter")
        {
            return;
        }

        try
        {
            await SelectItem(_selectedItem);
        }
        catch (OperationCanceledException exception)
        {

        }
    }

    private async Task SelectThroughKeyboard(KeyboardEventArgs args)
    {
        var keyCode = args.Code;
        if (keyCode != "ArrowDown" && keyCode != "ArrowUp")
        {
            _keyboardIndex = -1;
            return;
        }

        _keyboardIndex = keyCode == "ArrowUp" ? _keyboardIndex - 1 : _keyboardIndex + 1;
        _selectedItem = Suggestions[_keyboardIndex];

        StateHasChanged();
        return;
    }

    public async Task HandleBlur()
    {
        await Task.CompletedTask;
    }
}
