@using TableTennisShared.DTO.User
@inject ApiClient ApiClient

<div class="d-flex align-items-center justify-content-center mb-3">
    <div class="me-2">
        <i class="bi bi-trophy-fill"></i>
    </div>
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-1">TOP COMPETITORS</h5>
        <p class="mb-0">The best of the best</p>
    </div>
</div>

<div class="d-flex flex-column mb-3">
    @foreach (var (player, index) in TopPlayers.Select((player, index) => (player, index)))
    {
        <div class="d-flex align-items-center mt-3">
            <div class="me-2">
                <p class="mb-0">@(index + 1)</p>
            </div>
            <div class="mx-4 d-flex align-items-center justify-content-center rounded-5 player-profile__border">
                <p class="mb-0"> 
                    @Initial(player.FirstName)
                    @Initial(player.LastName)
                </p>
            </div>
            <div class="d-flex flex-column justify-content-center flex-grow-1 mx-4">
                <h5 class="mb-1">@player.FirstName @player.LastName</h5>
                <p class="mb-0">Atack specialist</p>
            </div>
            <div class="d-flex">
                <h5>@player.SinglesRating</h5>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Cutoff { get; set; }

    public List<TopPlayerDto> TopPlayers { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var players = await ApiClient.GetFromJsonAsyncAuthorized<IEnumerable<TopPlayerDto>>($"/user/top/{Cutoff}");

        if (players == null)
        {
            return;
        }

        TopPlayers.AddRange(players);
    }

    private static string Initial(string? name)
        => string.IsNullOrWhiteSpace(name) ? "" : name.Trim()[0].ToString().ToUpper();
}
