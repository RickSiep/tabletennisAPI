@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject TokenStorageHandler TokenHandler
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using TableTennisFrontEnd.Authentication

@if (!TokenHandler.IsInitialized)
{
    <p>Loading...</p>
}
else
{
    <div class="min-vh-100">
        <NavMenu />
        @Body
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TokenHandler.InitializeAsync();
            ((CustomAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}