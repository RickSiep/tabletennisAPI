@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TableTennisFrontEnd.Components.UI
@using TableTennisShared.DTO.Dashboard;
@inject ApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<div class="container-fluid">
    <div class="row g-3 mt-2">
        <div class="col-6">
            <div class="h-100 background-dark grey-border rounded p-5">
                <h2>WELCOME BACK, CHAMP.</h2>
                <p>The digital arena is active. Your current win rate is 78%. Ready for the next serve?</p>

                <div class="d-flex flex-row mt-5">
                    <button type="button" class="btn me-5 btn-primary rounded">Register match</button>
                    <button type="button" class="btn btn-secondary rounded">View rankings</button>
                </div>
            </div>
        </div>

        <div class="col-3">
            <StatsCard Title="TOTAL MATCHES PLAYED" Value="dashboardStats.TotalMatchesPlayed" />
        </div>

        <div class="col-3">
            <StatsCard Title="Matches played this week" Value="dashboardStats.MatchesPlayedThisWeek" />
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-4">
            <div class="h-100 background-dark grey-border rounded p-5">
                <TopPlayersComponent Cutoff="5" />
            </div>
        </div>
        <div class="col-8">
            <div class="h-100 background-dark grey-border rounded p-5">
                <h2>WELCOME BACK, CHAMP.</h2>
                <p>The digital arena is active. Your current win rate is 78%. Ready for the next serve?</p>

                <div class="d-flex flex-row mt-5">
                    <button type="button" class="btn me-5 btn-primary rounded">Register match</button>
                    <button type="button" class="btn btn-secondary rounded">View rankings</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    public DashboardStatsDto dashboardStats { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var statistics = await ApiClient.GetFromJsonAsyncAuthorized<DashboardStatsDto>("/stats/dashboard");

            if (statistics == null)
            {
                return;
            }

            dashboardStats = statistics;
        }
        catch
        {
            return;
        }
    }
}