@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@inject ApiClient ApiClient
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<div class="container-fluid">
    <div class="row g-3 mt-2">
        <div class="col-6">
            <div class="h-100 background-dark grey-border rounded p-5">
                <h2>WELCOME BACK, CHAMP.</h2>
                <p>The digital arena is active. Your current win rate is 78%. Ready for the next serve?</p>

                <div class="d-flex flex-row mt-5">
                    <button type="button" class="btn me-5 btn-primary rounded">Register match</button>
                    <button type="button" class="btn btn-secondary rounded">View rankings</button>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="h-100 grey-border d-flex flex-column justify-content-center align-items-center background-dark rounded p-3">
