@page "/matches"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using TableTennisFrontEnd.Authentication
@using Microsoft.AspNetCore.Authorization
@using TableTennisShared.DTO.Match
@using TableTennisFrontEnd.Components.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Matches</PageTitle>

<TableTennisFrontEnd.Components.UI.LoadingSpinnerComponent IsLoading="_isLoading" />
<h1 class="text-center">Matches</h1>
<div class="container">
    <GenericTableComponent TItem=MatchInformationDto OnPageChanged="UpdateMatches" Items="@MatchDtos" TotalCount="@_totalMatches">
        <HeaderTemplate>
            <th>Voornaam</th>
            <th>Voornaam tegenstander</th>
            <th>Gewonnen</th>
            <th>Verschil in Elo</th>
            <th>Gespeeld op</th>
        </HeaderTemplate>
        <RowTemplate>
            <td>@context.WinnerName</td>
            <td>@context.LoserName</td>
            <td>@(context.Winner? @context.WinnerName: @context.LoserName)</td>
            <td>@context.EloDifference</td>
            <td>@context.DatePlayed.ToShortDateString()</td>
            <td>
                <button class="btn btn-primary"><NavLink class="nav-link" href=@($"match/edit/{context.MatchId}")>Edit</NavLink></button>
                <button class="btn btn-danger" @onclick="() => DeleteMatch(context.MatchId)">Delete</button>
            </td>
        </RowTemplate>
    </GenericTableComponent>
    <div class="d-flex justify-content-center align-items-center mt-2">
        <button class="btn btn-primary" @onclick="NavigateToAddMatch">Add Match</button>
    </div>
</div>


@code {
    public List<MatchInformationDto> MatchDtos { get; set; } = [];
    private int _totalMatches;
    private int _pageIndex = 1;
    private string _accessToken = string.Empty;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            await UpdateMatches(_pageIndex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateMatches(int pageIndex)
    {
        _pageIndex = pageIndex;
        var formattedMatches = await ApiClient.GetFromJsonAsyncAuthorized<MatchInformationWithTotalMatchesDto>($"/match/formatted?pageIndex={_pageIndex}&pageSize=5");
        MatchDtos = formattedMatches.MatchInformations;
        _totalMatches = formattedMatches.TotalMatches;
    }

    private void NavigateToAddMatch() => Navigation.NavigateTo("/matches/add");

    private async Task DeleteMatch(int matchId)
    {
        _isLoading = true;
        await ApiClient.DeleteRouteAuthorizedAsync($"/match/delete/{matchId}", _accessToken);
        await UpdateMatches(_pageIndex);
        _isLoading = false;
    }
}
