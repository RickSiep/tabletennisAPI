@page "/matches/singles"
@rendermode InteractiveServer
@using TableTennisFrontEnd.Components.UI
@using TableTennisShared.DTO.Match
@using TableTennisShared.DTO.User
<PageTitle>Add singles</PageTitle>

@if (_loading)
{
    <LoadingSpinnerComponent IsLoading=@_loading />
}

<div class="container">
    <h3>Add a match!</h3>
    <EditForm method="post" FormName="AddMatchForm" Model=SinglesMatch OnValidSubmit="HandleValidSubmit" Enhance>
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        <div class="col-12 col-md-6">
            <h4>Winner</h4>
            <div class="form-group">
                <label for="winner" class="form-label">Winner</label>
                <SuggestionInputText TItem=UserIdAndNameDto @bind-Value="Player.Id" />
            </div>
        </div>
    </EditForm>
</div>

@code {
    private bool _loading;

    public UserIdAndNameDto Player { get; set; } = new();
    public SinglesMatchDto SinglesMatch { get; set; } = new();

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    private async Task HandleValidSubmit()
    {

    }
}
