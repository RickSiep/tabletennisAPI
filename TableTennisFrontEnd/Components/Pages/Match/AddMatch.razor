@page "/matches/add"
@page "/matches/add/{MatchId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using TableTennisFrontEnd.Authentication
@using TableTennisFrontEnd.Components.UI
@using TableTennisShared.DTO.Match
@using TableTennisShared.DTO.User
@inject ApiClient Client
@inject AuthenticationStateProvider AuthStateProvider
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager NavigationManager

<h3>Add a match!</h3>

@if (_loading)
{
    <LoadingSpinnerComponent IsLoading=@_loading />
}
else
{
    <div class="mt-2">
        <EditForm method="post" FormName="addMatch" Model="Match" OnValidSubmit="HandleValidSubmit" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="row">
                @for (var i = 0; i < Match.Participants.Count; i++)
                {
                    var participant = Match.Participants[i];
                    <div class="col-12 col-md-6">
                        @if (i == 0)
                        {
                            <h4>Winner</h4>
                            <div class="form-group">
                                <label for="user" class="form-label">User</label>
                                <InputSelect type="select" class="form-control" @bind-Value="participant.UserId" placeholder="user">
                                    @foreach (var user in Users)
                                    {
                                        <option value="@user.Id">@user.FirstName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => participant.UserId" class="text-danger" />
                            </div>
                            <div class="form-group">
                                <label for="user" class="form-label">Winner score</label>
                                <InputNumber class="form-control" @bind-Value="Match.WinnerScore" placeholder="Winner score" />
                                <ValidationMessage For="() => Match.WinnerScore" class="text-danger" />
                            </div>
                        }
                        else
                        {
                            <h4>Loser</h4>
                            <div class="form-group">
                                <label for="user" class="form-label">User</label>
                                <InputSelect type="select" class="form-control" @bind-Value="participant.UserId" placeholder="user">
                                    @foreach (var user in Users)
                                    {
                                        <option value="@user.Id">@user.FirstName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => participant.UserId" class="text-danger" />
                            </div>
                            <div class="form-group">
                                <label for="user" class="form-label">Loser score</label>
                                <InputNumber class="form-control" @bind-Value="Match.LoserScore" placeholder="Winner score" />
                                <ValidationMessage For="() => Match.LoserScore" class="text-danger" />
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mt-2 form-group">
                <button type="submit" class="btn btn-primary bg-dark">Submit</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int? MatchId { get; set; }

    private bool _loading;
    public List<UserIdAndNameDto> Users { get; set; } = [];
    public MatchSubmissionDto Match { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        for (int i = 0; i < 2; i++)
        {
            if (i == 0)
            {
                Match.Participants.Add(new() { IsWinner = true });
            }
            else
            {
                Match.Participants.Add(new() { IsWinner = false });
            }
        }
        var token = (await LocalStorage.GetAsync<string>("authToken")).Value;

        if (token == null)
        {
            throw new UnauthorizedAccessException("No authentication token found.");
        }

        try
        {
            Users = await Client.GetFromJsonAsyncAuthorized<List<UserIdAndNameDto>>("/user/firstname", token);
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
        await base.OnInitializedAsync();
        _loading = false;
    }

    private async Task HandleValidSubmit()
    {
        _loading = true;
        try
        {
            var response = await Client.PostJsonAsync<MatchSubmissionDto>("/match/save", Match);
            if (response != null)
            {
                NavigationManager.NavigateTo("/matches", false);
            }
            else
            {
                Console.WriteLine("error in saving");
            }
        }
        catch (Exception e)
        {
            Console.WriteLine("Error in process");
        }

        _loading = false;
    }
}
