@using TableTennisShared.DTO.Match
@inject ApiClient ApiClient

<TableTennisFrontEnd.Components.UI.LoadingSpinnerComponent IsLoading="_isLoading" />
<div class="container">
    <div class="row">
        <div class="d-none d-lg-block col-lg-2">
            <h3>Linkerkant</h3>
        </div>
        <div class="col-8">
            <div class="d-flex justify-content-center align-items-center flex-column">
                @foreach (var matchesAndDate in MatchesPerDayDtos)
                {
                    <h3>@matchesAndDate.Date.ToShortDateString()</h3>
                    @foreach (var match in matchesAndDate.Matches)
                    {
                        <div class="border-1 bg-success w-100 d-flex">
                            <div class="w-50">
                                <h4>@match.WinnerName</h4>
                                <h3>@match.WinnerScore</h3>
                            </div>
                            <div class="w-50">
                                <h4>@match.LoserName</h4>
                                <h3>@match.LoserScore</h3>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="d-none d-lg-block col-md-2">
            <h3>Rechterkant</h3>
        </div>
    </div>

</div>

@code {
    [Parameter]
    public int PageSize { get; set; }
    public List<MatchesPerDayDto> MatchesPerDayDtos { get; set; } = [];
    private int _pageIndex = 1;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await LoadMatches();
        await base.OnInitializedAsync();
        _isLoading = false;
    }

    private async Task LoadMatches()
    {
        MatchesPerDayDtos = await ApiClient.GetFromJsonAsync<List<MatchesPerDayDto>>($"/match/formatted/date?pageIndex={_pageIndex}&pageSize={PageSize}");
    }
}
