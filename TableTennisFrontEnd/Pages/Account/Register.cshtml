@page
@model TableTennisFrontEnd.Pages.Account.RegisterModel

<header class="fullscreen-header bg-primary h-100 d-flex no-padding-top">
    <div class="row g-0 justify-content-center align-items-center background-image--crystal_tower w-100 vh-100">
        <div class="col-md-5 text-center mx-2 background-gradient--purple_reversed rounded d-flex flex-column">
            <div class="my-2 mx-5 py-5">
                <h2>Register</h2>
                <form method="post" action="/account/register">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <button type="submit" class="btn btn-primary bg-dark">Submit</button>

                    <div class="d-flex flex-column">
                        <div class="form-group">
                            <label for="firstName" class="form-label align-self-end">First name</label>
                            <input type="text" class="form-control" name="FirstName" placeholder="Enter first name" />
                        </div>

                        <div class="form-group mt-2">
                            <label for="email" class="form-label">Last name</label>
                            <input type="text" class="form-control" name="LastName" placeholder="Enter last name" />
                        </div>

                        <div class="form-group mt-2">
                            <label for="email" class="form-label">Email address</label>
                            <input type="email" class="form-control" name="Email" placeholder="Enter email" />
                        </div>

                        <div class="form-group my-2">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" name="Password" placeholder="Enter password" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary bg-dark">Submit</button>
                </form>
            </div>
            <a href="/Account/Register" class="btn btn-secondary">Register</a>
        </div>
    </div>
</header>

@{
}
